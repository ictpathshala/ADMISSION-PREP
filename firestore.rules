rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ নিচের ইমেইল আপনার অ্যাডমিন Gmail দিয়ে বদলান
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['mdsanu2018@gmail.com'];
    }
    function signedIn() { return request.auth != null; }
    function subEnabled() {
      return exists(/databases/$(database)/documents/settings/app)
        && get(/databases/$(database)/documents/settings/app).data.subscriptionEnabled == true;
    }
    function subActive() {
      return exists(/databases/$(database)/documents/subs/$(request.auth.uid))
        && get(/databases/$(database)/documents/subs/$(request.auth.uid)).data.expiresAt > request.time;
    }

    // অ্যাপ সেটিংস (প্ল্যান, পেমেন্ট নম্বর, সাবস্ক্রিপশন চালু/বন্ধ)
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ইউজার প্রোফাইল
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'photo', 'lastLogin']);
      allow delete: if isAdmin();
    }

    // সাবস্ক্রিপশন স্ট্যাটাস (শুধু অ্যাডমিন লিখতে পারে)
    match /subs/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // কনটেন্টের তালিকা (শিরোনাম, ধরন, বিষয়)
    match /content/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // কনটেন্টের আসল লিংক — শুধু অনুমতি থাকলে পড়া যাবে
    match /links/{id} {
      allow get: if isAdmin() || (signedIn() && (
        get(/databases/$(database)/documents/content/$(id)).data.free == true
        || !subEnabled()
        || subActive()));
      allow write: if isAdmin();
    }

    // পেমেন্ট রিকোয়েস্ট
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update, delete: if isAdmin();
    }
  }
}
